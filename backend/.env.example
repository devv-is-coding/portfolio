# Template for backend/.env (gitignored). Copy it:  cp .env.example .env
# Never put real secrets in this file; it is committed.
#
# In production (e.g. Vercel), set the same variables in the platform's
# environment-variable settings instead of a file. Every value here is optional locally:
# the defaults in app/core/config.py match compose.yaml.

APP_NAME="Portfolio API"
ENVIRONMENT=development
# JSON list of allowed frontend origins. Add your production domain(s) in production.
CORS_ORIGINS=["http://localhost:3000"]

# MariaDB. These values match the local Docker database as seen from the HOST
# (uv run …, alembic). Inside Docker, compose.yaml sets DB_HOST=mariadb, DB_PORT=3306.
# Production: your managed database's host, port, name, user and password.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio

# Redis: cache + Celery broker/result backend. Matches compose.yaml from the host.
# Inside Docker, compose.yaml sets REDIS_URL=redis://redis:6379/0.
REDIS_URL=redis://localhost:6380/0

# Sentry error monitoring. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging. LOG_FORMAT=json writes one JSON object per line (use it in production);
# text is easier to read locally. Every line includes the request id (X-Request-ID).
LOG_LEVEL=INFO
LOG_FORMAT=text

# Admin authentication.
# JWT_SECRET_KEY signs access tokens: at least 32 characters, random, secret.
# Locally a development key is used when it's unset. With ENVIRONMENT=production the
# API refuses to start until you set your own. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Failed logins allowed per client IP, then 429 until the window (seconds) ends.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
