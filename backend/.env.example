# Template for backend/.env (gitignored). Copy it:  cp .env.example .env
# Never put real secrets in this file; it is committed.
#
# In production (e.g. Vercel), set the same variables in the platform's
# environment-variable settings instead of a file. Every value here is optional locally:
# the defaults in app/core/config.py match compose.yaml.

APP_NAME="Portfolio API"
ENVIRONMENT=development
# JSON list of allowed frontend origins: scheme://host[:port], no path or trailing slash,
# never "*". With ENVIRONMENT=production every origin must be https://.
CORS_ORIGINS=["http://localhost:3000"]
# Largest accepted request body in bytes (1 MiB); bigger requests get 413.
MAX_REQUEST_BODY_BYTES=1048576

# Trusted proxies (read by uvicorn, not by the app). The per-IP limits (login, contact)
# use the X-Forwarded-For client IP only from these addresses; everyone else is seen
# as the connecting IP. Default: localhost only. In production, set it to the IP or
# CIDR of the proxy or Next.js server in front of the API, e.g. 10.0.0.5 or 10.0.0.0/24.
# Never "*" while the API is also reachable directly: anyone could fake their IP.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# MariaDB. These values match the local Docker database as seen from the HOST
# (uv run …, alembic). Inside Docker, compose.yaml sets DB_HOST=mariadb, DB_PORT=3306.
# Production: your managed database's host, port, name, user and password.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
# Connection pool per API process. Keep WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# below MariaDB's max_connections (151 by default), with room for the worker.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis: cache + Celery broker/result backend. Matches compose.yaml from the host.
# Inside Docker, compose.yaml sets REDIS_URL=redis://redis:6379/0.
REDIS_URL=redis://localhost:6380/0

# Production processes. WEB_CONCURRENCY is read by uvicorn (`fastapi run`, ignored by
# `fastapi dev`): API worker processes, e.g. one or two per CPU core.
# Both default to 1, sized for a small server; raise them only when traffic needs it.
# CELERY_WORKER_CONCURRENCY: Celery worker processes (each ~50 MB).
# WEB_CONCURRENCY=1
CELERY_WORKER_CONCURRENCY=1

# Sentry error monitoring. Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ImageKit (media files). From the ImageKit dashboard -> Developer options.
# Optional locally: without them the /admin/media endpoints answer 503.
# Required with ENVIRONMENT=production. The private key is a secret: never commit it,
# and never give it a NEXT_PUBLIC_ prefix in the frontend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Logging. LOG_FORMAT=json writes one JSON object per line (use it in production);
# text is easier to read locally. Every line includes the request id (X-Request-ID).
LOG_LEVEL=INFO
LOG_FORMAT=text

# Admin authentication.
# JWT_SECRET_KEY signs access tokens: at least 32 characters, random, secret.
# Locally a development key is used when it's unset. With ENVIRONMENT=production the
# API refuses to start until you set your own. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Failed logins allowed per client IP, then 429 until the window (seconds) ends.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Contact form messages allowed per client IP, then 429 until the window (seconds) ends.
CONTACT_MAX_MESSAGES=5
CONTACT_WINDOW_SECONDS=3600

# Email about new contact messages, sent by the Celery worker over SMTP.
# Optional: without SMTP_HOST, SMTP_FROM and CONTACT_NOTIFY_EMAIL no email is sent
# (messages are still saved in the admin inbox).
# SMTP_STARTTLS=true uses STARTTLS (usually port 587); false uses implicit TLS (465).
# Gmail: smtp.gmail.com, port 587, your address as username, an app password.
# SMTP_PASSWORD is a secret: set it only in backend/.env or the platform's settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=
