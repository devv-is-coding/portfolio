# Template for frontend/.env.local (gitignored). Copy it:  cp .env.example .env.local
# Never put real secrets in this file; it is committed.
#
# On Vercel, set the same variables in Project -> Settings -> Environment Variables
# (Production / Preview / Development). `vercel env pull .env.local` downloads them.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so anyone can read them.
# Never give a secret (API keys, tokens, passwords) the NEXT_PUBLIC_ prefix.

# Backend URL used by the BROWSER (client components).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used by SERVER code (Server Components, route handlers). Read at runtime.
# In Docker Compose this is http://backend:8000 (set in compose.yaml).
API_URL=http://localhost:8000
