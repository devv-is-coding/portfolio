# Copy to frontend/.env.local for local development.

# Backend URL used by the BROWSER (client components). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used by SERVER code (Server Components, route handlers). Read at runtime.
# In Docker Compose this is http://backend:8000 (set in compose.yaml).
API_URL=http://localhost:8000
